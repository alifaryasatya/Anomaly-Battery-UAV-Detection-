  "dependency_versions": {
    "python": "3.13.3",
    "packages": {
      "numpy": "2.5.4",
      "pandas": "3.0.6",
      "scikit-learn": "1.9.1",
      "PyYAML": "6.0.3",
      "matplotlib": "3.11.2",
      "joblib": "1.6.0"
    }
  },
  "stage_order": [
    "preprocess",
    "features",
